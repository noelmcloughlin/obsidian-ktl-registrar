{
	"compilerOptions": {
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2021",
		"strict": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		// obsidian-sample-plugin uses "node" (node10) here; that is deprecated and
		// errors on TypeScript 7. "bundler" is the modern equivalent for an
		// esbuild-bundled plugin and resolves relative paths and the bare
		// "obsidian" specifier identically.
		"moduleResolution": "bundler",
		// "bundler" resolves package.json "exports" under the "import"/"types"
		// conditions only, never "node" (TypeScript's own moduleNameResolver
		// excludes it for this resolution kind). @types/node's node:fs/node:path/
		// node:url/node:module subpaths sit behind that condition, so
		// scripts/smoke-test.ts's and scripts/build-vocab.mjs's plain-Node
		// imports stop resolving the moment @types/node gates them on it -
		// exactly what a TypeScript 7 / @types/node 26 bump does. Re-adding the
		// condition here is the documented fix, not a workaround.
		"customConditions": ["node"],
		"isolatedModules": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"allowSyntheticDefaultImports": true,
		// ES2022 for Array.prototype.at(), which src/main.ts uses; esbuild.config.mjs's
		// own target is unaffected - this only widens what tsc type-checks against.
		"lib": ["ES2022", "DOM"]
	},
	"include": ["src/**/*.ts", "scripts/**/*.ts"]
}
