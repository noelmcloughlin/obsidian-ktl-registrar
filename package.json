{
  "name": "@noelmcloughlin/ktl-registrar",
  "version": "1.5.0",
  "description": "Catch broken note links, missing properties and invalid note types in your frontmatter as you write, so the vault stays a well-formed knowledge graph. The registrar role for Linked Open Knowledge Format (LOKF), a semantic profile of OKF.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "build-vocab": "node scripts/build-vocab.mjs",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "check": "npm run build && npm run lint && npm run smoke-test"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "lokf",
    "okf",
    "linked-open-knowledge-format",
    "open-knowledge-format",
    "frontmatter",
    "metadata",
    "linked-data"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@eslint/js": "^9.39.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.1",
    "esbuild": "0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "js-yaml": "^5.4.2",
    "obsidian": "latest",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "obsidian": {
      "@codemirror/state": "$@codemirror/state",
      "@codemirror/view": "$@codemirror/view"
    }
  }
}
